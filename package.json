{
  "name": "cloud-coding-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check && prettier --check .",
    "lint:fix": "biome check --write && prettier --write .",
    "format": "biome format --write && prettier --write .",
    "typecheck": "tsc --noEmit",
    "predev": "pnpm db:migrate && pnpm db:seed",
    "vercel-build": "drizzle-kit migrate && next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.7",
    "@ai-sdk/react": "^4.0.15",
    "@e2b/desktop": "^2.3.1",
    "@neondatabase/serverless": "^1.1.0",
    "@shadcn/react": "^0.2.0",
    "ai": "^7.0.14",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.12.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
