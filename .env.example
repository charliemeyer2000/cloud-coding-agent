# Copy to .env.local and fill in. Every key below is required unless noted.

# --- LLM (Anthropic via AI SDK) ---
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: model used by the agent. Any Anthropic model id works.
AGENT_MODEL=claude-sonnet-4-5

# --- E2B (sandbox VMs with a desktop) ---
# Get one at https://e2b.dev/dashboard
E2B_API_KEY=

# --- Database (Neon Postgres) ---
# Local: create a project at https://console.neon.tech and copy the pooled
# connection string. Prod: the Vercel Neon integration injects this for you.
DATABASE_URL=

# --- Auth (better-auth) ---
# Any long random string. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
